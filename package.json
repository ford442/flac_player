{
  "name": "flac-player",
  "version": "1.0.0",
  "description": "A React app for playing FLAC and WAV audio with WebGPU shader interface",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build:wasm": "bash ./scripts/build-wasm.sh --all",
    "build:wasm:sdl3": "bash ./scripts/build-wasm.sh --sdl3",
    "build:wasm:sdl2": "bash ./scripts/build-wasm.sh --sdl2",
    "build:projectm": "bash ./scripts/build-projectm-wasm.sh",
    "verify:wasm": "bash ./scripts/verify-wasm-artifacts.sh",
    "build": "webpack --mode production",
    "build:all": "npm run build:wasm && npm run build",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:decoder && npm run test:e2e",
    "test:unit": "vitest run",
    "test:decoder": "vitest run --config vitest.decoder.config.ts",
    "test:e2e": "npx playwright test",
    "test:streaming": "echo 'Test large file streaming after Phase 2'",
    "test:visualizer": "vitest run tests/rendererSelection.test.ts",
    "profile:chrome": "lighthouse http://localhost:3000 --view --preset=desktop"
  },
  "dependencies": {
    "@wasm-audio-decoders/flac": "^0.2.10",
    "music-metadata": "^11.12.3",
    "music-metadata-browser": "^2.5.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@webgpu/types": "^0.1.38",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^29.1.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "optionalDependencies": {
    "lighthouse": "^12.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
