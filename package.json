{
  "name": "flac-player",
  "version": "1.0.0",
  "description": "A React app for playing FLAC and WAV audio with WebGPU shader interface",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build:wasm": "bash ./src/sdl/build_sdl2.sh",
    "prebuild": "npm run build:wasm",
    "build": "webpack --mode production",
    "postbuild": "test -f dist/sdl-audio.js || test -f dist/public/sdl-audio.js && test -f dist/sdl-audio.wasm || test -f dist/public/sdl-audio.wasm",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "test": "npm run test:decoder && npm run test:e2e",
    "test:decoder": "node tests/decoder.test.mjs",
    "test:e2e": "npx playwright test",
    "test:streaming": "echo 'Test large file streaming after Phase 2'",
    "test:visualizer": "echo 'Test WebGPU + fallback after Phase 3'",
    "profile:chrome": "lighthouse http://localhost:3000 --view --preset=desktop"
  },
  "dependencies": {
    "@wasm-audio-decoders/flac": "^0.2.10",
    "music-metadata": "^11.12.3",
    "music-metadata-browser": "^2.5.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@webgpu/types": "^0.1.38",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  },
  "optionalDependencies": {
    "lighthouse": "^12.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
