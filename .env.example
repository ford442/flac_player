# =============================================================================
# FLAC Player - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Configuration (app.py)
# -----------------------------------------------------------------------------

# Data storage directories (default: ./data)
DATA_DIR=./data

# Server configuration
HOST=0.0.0.0
PORT=7860

# Application base URL for generating share links
# Change this to your actual deployment URL
APP_BASE_URL=https://your-username-flac-player.hf.space

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# MusicBrainz API Configuration
# MusicBrainz is free and requires no API key, but requires a User-Agent header
MUSICBRAINZ_USER_AGENT=FLAC-Player/1.0 (your-email@example.com)

# TinyURL API (optional - for URL shortening)
# Get your API key from: https://tinyurl.com/app/dev
# Leave empty to use internal short URLs only
TINYURL_API_KEY=

# -----------------------------------------------------------------------------
# Frontend Configuration (React)
# -----------------------------------------------------------------------------

# API base URL - set to your backend URL
# Leave empty for same-origin (when frontend and backend are served together)
# For HF Space, this should match your Space URL
REACT_APP_API_URL=

# Google Analytics 4 Measurement ID (optional)
# Get yours from: https://analytics.google.com/
REACT_APP_GA_ID=G-XXXXXXXXXX

# Mixpanel Token (optional)
# Get yours from: https://mixpanel.com/
REACT_APP_MIXPANEL_TOKEN=

# =============================================================================
# Hugging Face Space Deployment Notes
# =============================================================================
# 
# When deploying to Hugging Face Spaces:
# 
# 1. Set these secrets in your Space settings:
#    - TINYURL_API_KEY (if using TinyURL)
#    - APP_BASE_URL (your Space URL)
#
# 2. For analytics, add your GA_ID or MIXPANEL_TOKEN as secrets
#
# 3. The backend will automatically use the PORT env var from HF Spaces
#
# 4. Data persistence: HF Spaces provides persistent storage at /data
#    Set DATA_DIR=/data for production deployments
#
# =============================================================================
# Local Development
# =============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Modify values as needed for your local setup
#
# 3. Install Python dependencies:
#    pip install fastapi uvicorn httpx aiocache pydantic
#
# 4. Run the backend:
#    python app.py
#
# 5. In a separate terminal, run the frontend:
#    npm start
#
# =============================================================================
